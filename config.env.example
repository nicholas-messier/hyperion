# =============================================================
# config.env — Server-specific configuration
#
# Copy this file to config.env and fill in your values:
#   cp config.env.example config.env
#
# config.env is git-ignored and will not be pushed to GitHub.
# All scripts source this file for paths, drives, and settings.
# =============================================================

# ── User & Paths ─────────────────────────────────────────────
USERNAME="your_username"
HOME_DIR="/home/your_username"
BIN_DIR="/home/your_username/bin"

# ── Media Library ────────────────────────────────────────────
# Root path to your Plex/ErsatzTV media library
MEDIA_SOURCE="/path/to/media"
# Subdirectories within MEDIA_SOURCE containing your content
MEDIA_DIRS=("Movies" "TV Shows")

# ── Drive Mounts ─────────────────────────────────────────────
# Primary data drive (where media lives)
DATA_DRIVE_PATH="/path/to/data/drive"
# Archive/backup drive (local second drive for nightly sync)
ARCHIVE_DRIVE_PATH="/path/to/archive/drive"
# External backup drive (USB, used with archive.sh --export)
EXTERNAL_DRIVE_DEV="/dev/sdX"
EXTERNAL_DRIVE_MOUNT="/mnt/external"
EXTERNAL_DRIVE_MEDIA="/path/to/external/media"

# ── Backup (archive.sh) ─────────────────────────────────────
BACKUP_SOURCE="/path/to/data/"
BACKUP_STAGING="/path/to/archive/staging"
BACKUP_EXTERNAL_TARGET="/mnt/external/backup"
BACKUP_LOG_DIR="/var/log/archive"
BACKUP_RETENTION_DAYS=30

# ── Conky Dashboard ──────────────────────────────────────────
# Weather station ID from https://api.weather.gov/stations
WEATHER_STATION="KXXX"
# Display label for weather location
WEATHER_LOCATION="Your City ST"

# Sports team to track (ESPN abbreviation)
SPORTS_TEAM="BOS"
SPORTS_TEAM_NAME="Celtics"
SPORTS_LEAGUE="nba"

# World clock time zones (format: TZ_ID:Label, comma-separated)
CONKY_TIMEZONES="America/New_York:Eastern,America/Chicago:Central,America/Denver:Mountain,America/Los_Angeles:Pacific"

# Disk paths shown in conky system panel (df display)
# These are the mount points or device paths df will report on
CONKY_DATA_DISK="/path/to/data/mount"
CONKY_ARCHIVE_DISK="/path/to/archive/mount"
CONKY_EXTERNAL_DISK="/path/to/external/mount"

# ── Services ─────────────────────────────────────────────────
PLEX_SERVICE="plexmediaserver"
ERSATZTV_CONTAINER="ersatztv"
MINECRAFT_SERVICE="minecraft.service"
PIHOLE_ENABLED=true
