## ─────────────────────────────────────────────────────────────
## StarRupture Dedicated Server — environment configuration
##
## Copy this file to `.env` and fill in your secrets:
##   cp .env.example .env
##   $EDITOR .env
##
## `.env` is git-ignored (see ../.gitignore).
## Used by docker-compose.yml in this directory.
## Reference: https://github.com/indifferentbroccoli/starrupture-server-docker
## ─────────────────────────────────────────────────────────────

## ── Identity ────────────────────────────────────────────────
# Public display name shown in the server browser / "Manage Server"
SERVER_NAME=hyperion-starrupture

# Save-game session folder name (MAX 20 CHARACTERS)
# Becomes the folder under StarRupture/Saved/SaveGames/<SESSION_NAME>/
SESSION_NAME=HyperionWorld

## ── Networking ──────────────────────────────────────────────
# Default game/query ports. Compose file reads STARRUPTURE_PORT / _QUERY_PORT.
STARRUPTURE_PORT=7777
STARRUPTURE_QUERY_PORT=27015
# What the server process listens on inside the container (must match above)
DEFAULT_PORT=7777
QUERY_PORT=27015
# Optional: bind to a specific interface IP. Leave empty for all interfaces.
MULTIHOME=

## ── Security ────────────────────────────────────────────────
# Use DSSettings.txt instead of in-game Server Manager.
# IMPORTANT: keep this `true` for any internet-exposed server.
# (False forces TCP 7777 open, which is a documented security risk.)
USE_DSSETTINGS=true

# Admin password used for in-game admin commands.
# REQUIRED. Generate a strong one (e.g. `openssl rand -base64 24`).
# The image encrypts it into Password.json on first boot.
ADMIN_PASSWORD=CHANGE_ME_BEFORE_FIRST_START

# Player password — leave EMPTY for a public server.
# Set a value to require a password before players can join.
PLAYER_PASSWORD=

## ── Save game behavior ──────────────────────────────────────
# FIRST BOOT ONLY: set START_NEW_GAME=true and LOAD_SAVED_GAME=false,
# start the server, save your world, then flip these (see README).
START_NEW_GAME=true
LOAD_SAVED_GAME=false
SAVE_GAME_NAME=AutoSave0.sav
SAVE_GAME_INTERVAL=300

## ── Container behavior ──────────────────────────────────────
# The container's bundled SteamCMD is broken (writes to a non-writable HOME
# inside the image and fails with "Missing configuration"). Updates are
# instead done host-side by ./update.sh, which runs a clean steamcmd/steamcmd
# container with a writable HOME. Keep this false so the broken in-container
# updater doesn't run on every start.
UPDATE_ON_START=false

# File ownership inside the bind-mounted server-files/ dir.
# Match your host user (run `id -u` / `id -g`).
PUID=1000
PGID=1000
